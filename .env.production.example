# =============================================================================
# NEXUS CYBER DEFENSE — production environment template (Docker Compose)
# =============================================================================
#   copy .env.production.example .env.production
#   Replace every REPLACE_WITH_* value before running `docker compose up`.
# =============================================================================

# --- PostgreSQL (consumed by the db service) ---------------------------------
POSTGRES_USER=nexus
POSTGRES_DB=nexus
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Application -------------------------------------------------------------
NEXUS_ENV=production
NEXUS_APP_NAME=NEXUS Cyber Defense
NEXUS_SECRET_KEY=REPLACE_WITH_python_secrets_token_urlsafe_48
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:REPLACE_WITH_DB_PASSWORD@db:5432/nexus
NEXUS_DATA_DIR=/app/storage

# The SPA is served by the `web` container and calls the API through the same
# origin, so CORS is normally not needed. Add the public origin if you expose
# the API directly.
NEXUS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Worker ------------------------------------------------------------------
NEXUS_INPROCESS_WORKER=false
NEXUS_WORKER_CONCURRENCY=2
NEXUS_JOB_POLL_SECONDS=1.5
NEXUS_JOB_LEASE_SECONDS=120
NEXUS_MAX_CONCURRENT_SCANS=2

# --- Security policy ---------------------------------------------------------
NEXUS_ALLOW_PRIVATE_TARGETS=false
NEXUS_ACTIVE_SCANNING_ENABLED=true
# Self-service signup from the login page (viewer role only). Set to false to
# require an administrator to create every account.
NEXUS_SELF_REGISTRATION_ENABLED=true
NEXUS_RATE_LIMIT_PER_MINUTE=240
NEXUS_MAX_UPLOAD_MB=25

# --- Optional integrations ---------------------------------------------------
# nmap is installed in the API/worker image. Set NEXUS_NMAP_PATH only if you
# want to pin a specific binary.
NEXUS_NMAP_PATH=
NEXUS_ZAP_URL=
NEXUS_ZAP_API_KEY=

# AI Copilot is optional. Keep `none` unless a provider is configured.
NEXUS_AI_PROVIDER=none
NEXUS_AI_BASE_URL=
NEXUS_AI_API_KEY=
NEXUS_AI_MODEL=
NEXUS_AI_MAX_TOKENS=1200
NEXUS_AI_TIMEOUT_SECONDS=60
NEXUS_AI_MONTHLY_TOKEN_BUDGET=500000

# --- Threat intelligence -----------------------------------------------------
# NVD works without a key but is rate limited (5 requests / 30 s). Request a
# free key at https://nvd.nist.gov/developers/request-an-api-key to raise it.
NEXUS_NVD_API_KEY=
NEXUS_INTEL_CACHE_HOURS=24
NEXUS_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- Bootstrap owner (created only when the database is empty) ---------------
NEXUS_BOOTSTRAP_ADMIN_EMAIL=admin@nexus.local
NEXUS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
NEXUS_BOOTSTRAP_ADMIN_NAME=Nexus Admin
