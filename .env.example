# =============================================================================
# NEXUS CYBER DEFENSE — نموذج متغيرات البيئة
# =============================================================================
# انسخ هذا الملف إلى  backend\.env  (أو استخدم:  scripts\nexus.cmd setup  الذي ينسخه تلقائيًا
# وينشئ مفتاحًا سريًا عشوائيًا حقيقيًا بدل القيمة أدناه).
#
# ⚠️ لا تضع هذا الملف في Git. ملف  backend\.env  مُستثنى في .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) الأساسيات
# -----------------------------------------------------------------------------
NEXUS_ENV=development
NEXUS_APP_NAME=NEXUS Cyber Defense
# ولّده بأمر:  python -c "import secrets;print(secrets.token_urlsafe(48))"
NEXUS_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# قاعدة البيانات: SQLite للتطوير المحلي (بلا Docker)
NEXUS_DATABASE_URL=sqlite:///./storage/nexus.db
NEXUS_DATA_DIR=./storage

# الجلسات والرموز
NEXUS_ACCESS_TOKEN_MINUTES=30
NEXUS_REFRESH_TOKEN_DAYS=14

# الواجهة الأمامية المسموح لها بالوصول (CORS)
NEXUS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# 2) عامل المهام (Worker)
# -----------------------------------------------------------------------------
# true = يشغّل العامل داخل نفس عملية الـAPI (أبسط للتطوير على Windows 10)
# false = شغّل العامل كعملية مستقلة: python -m app.worker
NEXUS_INPROCESS_WORKER=true
NEXUS_WORKER_CONCURRENCY=2
NEXUS_JOB_POLL_SECONDS=1.5
NEXUS_JOB_LEASE_SECONDS=120
NEXUS_MAX_CONCURRENT_SCANS=2

# -----------------------------------------------------------------------------
# 3) سياسات الأمان الإلزامية (راجع docs/04-SECURITY-AND-COMPLIANCE.md)
# -----------------------------------------------------------------------------
# فحص الأهداف الخاصة (localhost / 10.x / 192.168.x) ممنوع افتراضيًا.
# لا تفعّلها إلا لمختبر تدريب معزول تملكه. عناوين Cloud Metadata محجوبة دائمًا.
NEXUS_ALLOW_PRIVATE_TARGETS=false
# تفعيل الفحص النشط المصرّح (Authorized Active Testing) على مستوى المنصة
NEXUS_ACTIVE_SCANNING_ENABLED=true
# إنشاء حساب ذاتي من صفحة الدخول (دور viewer فقط). اضبطها false لمنع التسجيل المفتوح.
NEXUS_SELF_REGISTRATION_ENABLED=true
NEXUS_RATE_LIMIT_PER_MINUTE=240
NEXUS_MAX_UPLOAD_MB=25

# -----------------------------------------------------------------------------
# 4) OWASP ZAP (اختياري — إن لم يُضبط تعمل المحركات الداخلية الحقيقية بدلًا منه)
# -----------------------------------------------------------------------------
NEXUS_ZAP_URL=
NEXUS_ZAP_API_KEY=

# -----------------------------------------------------------------------------
# 5) Nmap (اختياري — إن لم يوجد nmap يعمل ماسح TCP الداخلي الحقيقي)
# -----------------------------------------------------------------------------
NEXUS_NMAP_PATH=

# -----------------------------------------------------------------------------
# 6) AI Security Copilot — محوّل متعدد المزوّدين (اختياري بالكامل)
# -----------------------------------------------------------------------------
# القيم: none | openai | openrouter | azure | ollama | custom
# اتركه none ليعمل كل شيء عدا المساعد، وتظهر حالته بصراحة: "غير مهيّأ".
NEXUS_AI_PROVIDER=none
NEXUS_AI_BASE_URL=
NEXUS_AI_API_KEY=
NEXUS_AI_MODEL=
NEXUS_AI_MAX_TOKENS=1200
NEXUS_AI_TIMEOUT_SECONDS=60
# حد استخدام شهري تقديري (بالتوكنات) لحماية التكلفة
NEXUS_AI_MONTHLY_TOKEN_BUDGET=500000
# مثال OpenRouter (اختياري):
#   NEXUS_AI_PROVIDER=openrouter
#   NEXUS_AI_BASE_URL=https://openrouter.ai/api/v1
#   NEXUS_AI_API_KEY=sk-or-...
#   NEXUS_AI_MODEL=anthropic/claude-3.5-sonnet
# مثال Ollama محلي (بلا تكلفة وبلا إنترنت):
#   NEXUS_AI_PROVIDER=ollama
#   NEXUS_AI_BASE_URL=http://127.0.0.1:11434/v1
#   NEXUS_AI_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# 7) Threat Intelligence
# -----------------------------------------------------------------------------
# مفتاح NVD اختياري: يرفع الحد من 5 إلى 50 طلبًا/30ث. اطلبه من https://nvd.nist.gov/developers/request-an-api-key
NEXUS_NVD_API_KEY=
NEXUS_INTEL_CACHE_HOURS=24
NEXUS_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# -----------------------------------------------------------------------------
# 8) أول مستخدم (يُنشأ تلقائيًا عند setup فقط — غيّر كلمة المرور فورًا)
# -----------------------------------------------------------------------------
NEXUS_BOOTSTRAP_ADMIN_EMAIL=admin@nexus.local
NEXUS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!Nexus2026
NEXUS_BOOTSTRAP_ADMIN_NAME=Nexus Admin
